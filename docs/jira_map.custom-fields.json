    "func": "Consumer Bank function",
    "sponsor": "Business Sponsor",
    "wsjf": "WSJF",
    "est": {
      "field": "Estimated Annual Value",
      "scale": 1
    },
    "size": "Story Points",
    "impact": {
      "field": "Impact",
      "values": {
        "Revenue / growth": "revenue",
        "Cost / productivity": "cost",
        "Cycle time": "cycle",
        "Risk / control": "risk",
        "Decision / insight": "insight"
      }
    },
    "risk": {
      "field": "labels",
      "values": {
        "npi": "NPI",
        "reg-report": "Reg report",
        "no-human-review": "No human review"
      }
    },
    "dataReady": {
      "field": "Data Readiness",
      "values": {
        "Ready": "ready",
        "Partial": "partial",
        "Not available": "unavailable"
      }
    },
    "metric": "Success Metric",
    "baseline": "Baseline Captured",
    "waitingOn": "Waiting On",
    "target": "Stage Target Date",
    "next": "Next Step",
    "stage": null,
    "closedReason": "Close Reason",
    "techReady": {
      "field": "Technology Readiness",
      "values": {
        "Ready": "ready",
        "Partial": "partial",
        "Not ready": "unavailable"
      }
    },
    "pattern": "AI Pattern",
    "live": "Target Go-Live",
    "realized": {
      "field": "Realized Annual Value",
      "scale": 1
    },
    "dependsOn": {
      "field": "issuelinks",
      "linkTypes": "block|depend"
    }
